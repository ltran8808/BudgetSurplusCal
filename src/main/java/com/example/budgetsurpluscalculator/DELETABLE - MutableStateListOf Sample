@Composable
fun MyListScreen(viewModel: MyListViewModel = viewModel()) {
    val uiState by viewModel.uiState.collectAsState()

    LazyColumn {
        // Provide a unique key for each item
        items(uiState.items, key = { it.id }) { item ->
            ListItemTextField(
                itemState = item,
                onTextChange = { newText ->
                    viewModel.updateItemText(item.id, newText)
                }
            )
        }
    }
}

@Composable
fun ListItemTextField(
